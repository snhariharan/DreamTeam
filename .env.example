# DreamTeam — environment variables
# Copy this file to .env and fill in the keys you need.
# You only need keys for the provider(s) used by your chosen profile.
#
#   BALANCED / POWER  → OpenAI + Anthropic + Google
#   FAST / BUDGET     → OpenAI + Google
#   COPILOT           → GITHUB_TOKEN (no other AI keys needed)
#   LOCAL             → no API keys (Ollama runs offline)

# ── AI Providers ─────────────────────────────────────────────────────────────

# OpenAI — GPT-4.1, GPT-4.1-mini, GPT-4.1-nano
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Anthropic — Claude Sonnet 4.5, Claude Opus 4.5
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google AI — Gemini 2.5 Pro, Gemini 2.5 Flash
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# ── GitHub Copilot profile (COPILOT only) ─────────────────────────────────────
# Personal Access Token — requires the "copilot" scope
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...

# ── MCP Servers (optional — agents work fine without them) ───────────────────

# GitHub MCP — read repos, search code, view PRs/issues
# Same token as above; needs: repo, read:user scopes
# GITHUB_TOKEN is already set above — no duplicate needed

# Brave Search MCP — real-time web search (2,000 free queries/month)
# https://brave.com/search/api/
BRAVE_API_KEY=BSA...

# ── Optional tools ────────────────────────────────────────────────────────────

# Serper — Google-powered search for crewai SerperDevTool (2,500 free/month)
# https://serper.dev
SERPER_API_KEY=...
